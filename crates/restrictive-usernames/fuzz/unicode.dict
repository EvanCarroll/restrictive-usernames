u05D1="\xD7\x91"
u05D9="\xD7\x99"
u0627="\xD8\xA7"
u0628="\xD8\xA8"
u0626="\xD8\xA6"
u0649="\xD9\x89"
u0681="\xDA\x81"
u062D="\xD8\xAD"
