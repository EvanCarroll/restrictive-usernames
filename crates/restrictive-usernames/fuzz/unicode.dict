u0662="\xD9\xA2"
u06F2="\xDB\xB2"
u0600="\xD8\x80"
u05F3="\xD7\xB3"
u05F4="\xD7\xB4"

# Inclusion punctuation with CONTEXTO rules
u00B7="\xC2\xB7"
u0375="\xCD\xB5"
u30FB="\xE3\x83\xBB"
u30A0="\xE3\x82\xA0"
u2010="\xE2\x80\x90"
u2019="\xE2\x80\x99"
