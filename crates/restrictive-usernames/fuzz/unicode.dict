# libFuzzer dictionary for the restrictive-usernames fuzz targets.
# Pass with -dict=fuzz/unicode.dict. Each entry is one code point as UTF-8,
# named by its code point.
# One block per class of input the policy treats specially.

# spaces the keys and normalize map (RFC 8266) and line/paragraph separators
u00A0="\xC2\xA0"
u1680="\xE1\x9A\x80"
u2000="\xE2\x80\x80"
u2001="\xE2\x80\x81"
u2002="\xE2\x80\x82"
u2009="\xE2\x80\x89"
u200A="\xE2\x80\x8A"
u202F="\xE2\x80\xAF"
u205F="\xE2\x81\x9F"
u3000="\xE3\x80\x80"
u2028="\xE2\x80\xA8"
u2029="\xE2\x80\xA9"
u0009="\x09"
u000A="\x0A"
u0020="\x20"

# invisibles: joiners, bidi controls, variation selector, BOM, soft hyphen, tag
u200B="\xE2\x80\x8B"
u200C="\xE2\x80\x8C"
u200D="\xE2\x80\x8D"
u200E="\xE2\x80\x8E"
u200F="\xE2\x80\x8F"
u202A="\xE2\x80\xAA"
u202B="\xE2\x80\xAB"
u202C="\xE2\x80\xAC"
u202D="\xE2\x80\xAD"
u202E="\xE2\x80\xAE"
u2066="\xE2\x81\xA6"
u2067="\xE2\x81\xA7"
u2068="\xE2\x81\xA8"
u2069="\xE2\x81\xA9"
u061C="\xD8\x9C"
uFE0F="\xEF\xB8\x8F"
uFEFF="\xEF\xBB\xBF"
u00AD="\xC2\xAD"
uE0041="\xF3\xA0\x81\x81"

# combining marks: Latin, Hebrew points, Arabic hamza, Devanagari and Thai vowel signs, enclosing
u0300="\xCC\x80"
u0301="\xCC\x81"
u0307="\xCC\x87"
u0308="\xCC\x88"
u0334="\xCC\xB4"
u05B7="\xD6\xB7"
u05BC="\xD6\xBC"
u0654="\xD9\x94"
u0655="\xD9\x95"
u093F="\xE0\xA4\xBF"
u0941="\xE0\xA5\x81"
u094D="\xE0\xA5\x8D"
u0E34="\xE0\xB8\xB4"
